@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Publish a calendar feed

Person(artist, "Artist", "Approved worship artist")
System_Ext(calapp, "Calendar application", "Subscribes to iCalendar URLs")
System_Boundary(zamaro, "Zamaro") {
  Container(web, "Zamaro Web", "Angular with SSR", "Calendar feed dialog opened from /artist/calendar")
  Container(api, "Zamaro API", "PHP 8.3 / Laravel 11", "Feed management and feed endpoints under /api/v1")
  ContainerDb(db, "Zamaro database", "PostgreSQL 16", "calendar_feeds, bookings")
  ContainerDb(cache, "Cache and queue", "Redis", "Rate-limit counters")
}
Rel(artist, web, "Uses", "HTTPS")
Rel(web, api, "GET, POST /api/v1/artist/calendar-feed", "JSON/HTTPS")
Rel(calapp, api, "GET /api/v1/calendar-feeds/{token}.ics", "HTTPS")
Rel(api, db, "Reads and writes feeds; reads Confirmed bookings", "Eloquent / SQL")
Rel(api, cache, "Counts feed requests per IP", "RESP")
@enduml
