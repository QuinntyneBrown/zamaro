@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Sign in and recover access

Container(web, "Zamaro Web", "Angular", "AuthService, AuthApi, sign-in and security pages")
System_Ext(breach, "Breached-password service", "k-anonymity range query")
Container_Boundary(api, "Zamaro API") {
  Component(sessCtrl, "SessionController", "Laravel controller", "POST and DELETE /api/v1/session, POST /api/v1/session/two-factor")
  Component(attempt, "AttemptSignIn", "Action", "Checks lockout and credentials")
  Component(throttle, "SignInThrottle", "Service", "5 failures in 15 min blocks 15 min")
  Component(challenge, "CompleteTwoFactorChallenge", "Action", "Verifies TOTP or recovery code")
  Component(start, "StartSession", "Action", "Regenerates session ID and registers it")
  Component(signout, "SignOut", "Action", "Invalidates the session server-side")
  Component(pwCtrl, "PasswordResetController", "Laravel controller", "POST /api/v1/password/forgot and /reset")
  Component(sendLink, "SendPasswordResetLink", "Action", "Issues a 60-minute single-use token")
  Component(reset, "ResetPassword", "Action", "Sets the new password and ends every session")
  Component(policy, "PasswordPolicy", "Validation rule", "12-128 characters, not breached")
  Component(tfCtrl, "TwoFactorController", "Laravel controller", "POST /api/v1/account/two-factor and /confirm")
  Component(enable, "EnableTwoFactor / ConfirmTwoFactor", "Actions", "Secret, confirmation and 10 recovery codes")
  Component(registry, "SessionRegistry", "Service", "Indexes and ends a user's sessions")
  Component(audit, "RecordAuditEntry", "Action", "Writes sign-in, failure, password and MFA events")
  ComponentDb(db, "Zamaro database", "PostgreSQL 16", "users, password_reset_tokens, recovery_codes, user_sessions")
  ComponentDb(cache, "Cache and queue", "Redis", "Sessions, counters, email jobs")
}
Rel(web, sessCtrl, "Signs in and out", "JSON/HTTPS")
Rel(web, pwCtrl, "Requests and completes reset", "JSON/HTTPS")
Rel(web, tfCtrl, "Enables MFA", "JSON/HTTPS")
Rel(sessCtrl, attempt, "Calls")
Rel(sessCtrl, challenge, "Calls")
Rel(sessCtrl, signout, "Calls")
Rel(attempt, throttle, "Checks and increments")
Rel(throttle, cache, "Counters", "RESP")
Rel(attempt, start, "Starts session when no MFA")
Rel(challenge, start, "Starts session")
Rel(start, registry, "Registers session")
Rel(signout, registry, "Removes session")
Rel(registry, cache, "Destroys session payloads", "RESP")
Rel(registry, db, "user_sessions", "SQL")
Rel(pwCtrl, sendLink, "Calls")
Rel(pwCtrl, reset, "Calls")
Rel(reset, policy, "Validates with")
Rel(reset, registry, "Ends all sessions")
Rel(policy, breach, "Range query", "HTTPS")
Rel(tfCtrl, enable, "Calls")
Rel(enable, db, "Stores encrypted secret and code hashes", "SQL")
Rel(attempt, audit, "Records outcome")
Rel(audit, db, "Inserts audit_entries", "SQL")
Rel(sendLink, db, "Stores token hash", "SQL")
@enduml
