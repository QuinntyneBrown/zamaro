@startuml
title UML sequence behaviour — Reset a forgotten password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Booker or artist" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "ForgotPasswordPage" as forgot
  participant "ResetPasswordPage" as resetPage
  participant "AuthApi" as client
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "PasswordResetController" as controller
end box
box "Backend — Zamaro Application and Domain" #ECFDF3
  participant "SendPasswordResetLink" as send
  participant "ResetPassword" as reset
  participant "PasswordPolicy" as policy
  participant "SessionRegistry" as registry
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  participant "Bot challenge provider" as bot
  participant "Breached-password service" as breach
  database "Zamaro database" as db
  database "Cache and queue" as cache
end box

actor -> forgot : Enter email, pass bot challenge
forgot -> client : forgotPassword(email, challengeToken)
client -> controller : POST /api/v1/password/forgot
controller -> bot : Verify challenge (L2-077)
controller -> send : handle(email)
send -> db : Find user by email
opt account exists
  send -> db : Store SHA-256 token hash, expires in 60 min
  send -> cache : Queue ResetPasswordNotification
end
controller --> client : 202
forgot --> actor : "If that email has an account, we've sent a reset link." (L2-023)

actor -> resetPage : Open link, enter new password twice
resetPage -> client : resetPassword(token, password)
client -> controller : POST /api/v1/password/reset
controller -> reset : handle(token, password)
reset -> db : Find token by hash
alt token used, unknown or older than 60 min
  controller --> client : 410 problem details
  resetPage --> actor : Link expired, request a new one
else token valid
  reset -> policy : Validate 12-128 characters (L2-072)
  policy -> breach : Range query on SHA-1 prefix
  alt breached or wrong length
    controller --> client : 422 with reason
    resetPage --> actor : Reason shown, field kept
  else accepted
    reset -> db : Store Argon2id hash, mark token used (L2-023, L2-072)
    reset -> registry : endAll(user) (L2-023)
    registry -> cache : Destroy every session payload
    registry -> db : Delete user_sessions rows
    reset -> db : Insert audit entry for password change
    controller --> client : 204
    resetPage --> actor : Password changed, sign in
  end
end
@enduml
