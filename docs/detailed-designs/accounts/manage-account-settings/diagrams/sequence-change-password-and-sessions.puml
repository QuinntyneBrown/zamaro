@startuml
title UML sequence behaviour — Change the password and end sessions
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Booker or artist" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "AccountSettingsPage" as page
  participant "AccountApi" as client
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "AccountPasswordController" as pwCtrl
  participant "AccountSessionController" as sessCtrl
end box
box "Backend — Zamaro Application and Domain" #ECFDF3
  participant "ChangePassword" as change
  participant "EndSession" as endSess
  participant "SessionRegistry" as registry
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database" as db
  database "Cache and queue" as cache
end box

actor -> page : Enter current and new password, press Save changes
page -> client : changePassword(current, next)
client -> pwCtrl : PUT /api/v1/account/password
pwCtrl -> pwCtrl : Check current password, apply PasswordPolicy (L2-025, L2-072)
alt current password wrong or new password rejected
  pwCtrl --> client : 422 with reason
  page --> actor : Inline error
else accepted
  pwCtrl -> change : handle(user, next, currentSessionId)
  change -> db : Store Argon2id hash
  change -> registry : endAllExcept(user, current) (L2-025)
  registry -> cache : Destroy other session payloads
  registry -> db : Delete other user_sessions rows
  change -> cache : Regenerate current session ID (L2-073)
  change -> db : Insert audit entry for password change (L2-069)
  pwCtrl --> client : 204
  page --> actor : Saved banner; other devices signed out
end

actor -> page : Open "Signed-in devices"
page -> client : listSessions()
client -> sessCtrl : GET /api/v1/account/sessions
sessCtrl -> registry : list(user)
registry -> db : Select user_sessions for user
sessCtrl --> client : SessionResource[] with device, city, last active (L2-025)
page --> actor : Device list, current marked "This device"
actor -> page : End session on one row (acts at once)
page -> client : endSession(id)
client -> sessCtrl : DELETE /api/v1/account/sessions/{id}
sessCtrl -> endSess : handle(user, id)
alt id belongs to another user
  sessCtrl --> client : 404 (L2-074)
else owned
  endSess -> registry : end(user, id)
  registry -> cache : Destroy session payload
  registry -> db : Delete user_sessions row
  sessCtrl --> client : 204
  page --> actor : Row removed
end
@enduml
