@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage the church profile

Container(web, "Zamaro Web", "Angular", "ChurchFormComponent, ChurchApi, AuthService")
System_Ext(geo, "Geocoding provider", "Address to coordinates")
System_Ext(routing, "Routing provider", "Driving distance")
Container_Boundary(api, "Zamaro API") {
  Component(ctrl, "ChurchController", "Laravel controller", "GET and PUT /api/v1/account/church")
  Component(req, "SaveChurchRequest", "FormRequest", "Name 2-120, phone, attendance")
  Component(action, "SaveChurch", "Action", "Geocodes, checks service area, writes church")
  Component(geocoder, "Geocoder", "Interface + adapter", "Calls the geocoding provider")
  Component(area, "ServiceArea", "Domain service", "Within 200 km road distance of Toronto City Hall")
  Component(dist, "DistanceService", "Domain service", "Road distance with cache and fallback")
  Component(res, "ChurchResource / CurrentUserResource", "API resources", "Owner view of church; header initials and church name")
  ComponentDb(db, "Zamaro database", "PostgreSQL 16", "churches")
  ComponentDb(cache, "Cache and queue", "Redis", "Distance cache")
}
Rel(web, ctrl, "PUT /api/v1/account/church", "JSON/HTTPS")
Rel(ctrl, req, "Validates with")
Rel(ctrl, action, "Calls")
Rel(action, geocoder, "Geocodes address")
Rel(geocoder, geo, "Calls", "HTTPS/JSON")
Rel(action, area, "Checks contains(point)")
Rel(area, dist, "Measures distance from City Hall")
Rel(dist, cache, "Reads and writes", "RESP")
Rel(dist, routing, "Requests uncached pairs", "HTTPS/JSON")
Rel(action, db, "Upserts church", "SQL")
Rel(ctrl, res, "Returns")
@enduml
