@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage the church profile

Person(booker, "Booker", "Signed-in church representative")
System_Ext(geo, "Geocoding provider", "Address to coordinates")
System_Ext(routing, "Routing provider", "Driving distance")
System_Boundary(zamaro, "Zamaro") {
  Container(web, "Zamaro Web", "Angular with SSR", "ChurchProfilePage, ChurchRequiredDialogComponent, AccountMenuComponent")
  Container(api, "Zamaro API", "PHP 8.3 / Laravel 11", "GET and PUT /api/v1/account/church")
  ContainerDb(db, "Zamaro database", "PostgreSQL 16", "churches, bookings address snapshots")
  ContainerDb(cache, "Cache and queue", "Redis", "Distance cache")
}
Rel(booker, web, "Uses", "HTTPS")
Rel(web, api, "Reads and saves the church", "JSON/HTTPS")
Rel(api, geo, "Geocodes address", "HTTPS/JSON")
Rel(api, routing, "Requests distance to City Hall", "HTTPS/JSON")
Rel(api, cache, "Reads and writes cached distances", "RESP")
Rel(api, db, "Writes church", "Eloquent / SQL")
@enduml
