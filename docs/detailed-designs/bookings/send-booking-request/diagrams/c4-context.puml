@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Send a booking request

Person(booker, "Booker", "Signed-in church representative")
Person(artist, "Artist", "Approved worship artist")
System(zamaro, "Zamaro", "Books Christian praise and worship artists around Toronto")
System_Ext(email, "Email delivery service", "Transactional email")

Rel(booker, zamaro, "Sends a booking request from an artist profile using", "HTTPS")
Rel(zamaro, email, "Sends the new-request email through", "HTTPS")
Rel(email, artist, "Delivers the new-request email to")
Rel(artist, zamaro, "Opens the request in", "HTTPS")
@enduml
