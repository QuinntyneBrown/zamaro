@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Send a booking request

Person(booker, "Booker", "Signed-in church representative")
System_Ext(email, "Email delivery service", "Transactional email")
System_Boundary(zamaro, "Zamaro") {
  Container(web, "Zamaro Web", "Angular with SSR", "Artist profile with booking stub")
  Container(api, "Zamaro API", "PHP 8.3 / Laravel 11", "POST /api/v1/bookings")
  Container(worker, "Zamaro Worker", "Laravel queue workers", "Sends the artist email")
  ContainerDb(db, "Zamaro database", "PostgreSQL 16", "bookings, booking_transitions, messages")
  ContainerQueue(queue, "Cache and queue", "Redis", "Rate-limit counters and queued listeners")
}
Rel(booker, web, "Uses", "HTTPS")
Rel(web, api, "POST /api/v1/bookings with Idempotency-Key", "JSON/HTTPS")
Rel(api, db, "Checks availability and inserts the booking", "SQL")
Rel(api, queue, "Counts requests and queues BookingRequested", "RESP")
Rel(worker, queue, "Takes jobs from", "RESP")
Rel(worker, email, "Sends the new-request email through", "HTTPS")
@enduml
