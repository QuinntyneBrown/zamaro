@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View the booker's bookings

Person(booker, "Booker", "Signed-in church representative")
System_Boundary(zamaro, "Zamaro") {
  Container(web, "Zamaro Web", "Angular with SSR", "/bookings and /bookings/:number")
  Container(api, "Zamaro API", "PHP 8.3 / Laravel 11", "GET /api/v1/bookings and /api/v1/bookings/{number}")
  ContainerDb(db, "Zamaro database", "PostgreSQL 16", "bookings, payments, refunds, artists, reviews")
}
Rel(booker, web, "Uses", "HTTPS")
Rel(web, api, "Lists bookings and reads one booking", "JSON/HTTPS")
Rel(api, db, "Queries bookings scoped to the booker", "SQL")
@enduml
