@startuml
title UML sequence behaviour — Open the requests inbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Artist" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "ArtistRequestsPage" as page
  participant "ArtistRequestsStore" as store
  participant "ArtistRequestsApi" as client
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "ArtistRequestsController" as controller
end box
box "Backend — Zamaro Application and Domain" #ECFDF3
  participant "ListArtistRequests" as list
  participant "DistanceService" as dist
  participant "PriceBreakdown" as price
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database" as db
  database "Cache and queue" as cache
end box

actor -> page : Open /artist/requests (New tab)
page -> store : load()
store -> client : list(new)
client -> controller : GET /api/v1/artist/requests?tab=new
controller -> controller : Artist role, else 404 (L2-074)
controller -> list : handle(artist, new, query, cursor)
list -> db : Requested bookings of artist ORDER BY respond_by, id (L2-034)
db --> list : Bookings with church snapshot and recipient message view
loop each request
  list -> dist : between(artist base, church) (L2-002)
  dist -> cache : Cached pair
  cache --> dist : Distance (routing provider on miss)
  dist --> list : Distance
  list -> price : forBooking(booking)
  price --> list : payoutCents = total - 8 % fee
end
list --> controller : Page of ArtistRequestResource
controller --> client : 200 with next cursor
client --> store : Requests
store --> page : Render request rows
page --> actor : Church, city, distance, date, kind, start time, message preview,\nquoted price, payout and time left (L2-034)
actor -> page : Open a row
page --> actor : /artist/bookings/{number} with Accept and Decline;\nAccept states "You'll be paid ${payout} after the event." (L2-034)
@enduml
