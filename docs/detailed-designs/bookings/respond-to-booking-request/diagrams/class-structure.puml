@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Respond to a booking request

package "Zamaro Web (Angular)" {
  class ArtistRequestsPage {
    +store: ArtistRequestsStore
    +onSelectTab(tab: RequestsTab): void
    +onSearch(query: string): void
  }
  class RequestRowComponent {
    +request: InputSignal<ArtistRequest>
    +timeLeft: Signal<string>
  }
  class ArtistBookingPage {
    +store: ArtistBookingStore
    +onAccept(): void
    +onDecline(): void
  }
  class AcceptRequestDialogComponent {
    +booking: ArtistBookingDetail
    +state: Signal<'ready'|'busy'|'failed'|'conflict'>
    +confirm(): void
  }
  class DeclineRequestDialogComponent {
    +reason: FormControl<DeclineReason | null>
    +note: FormControl<string>
    +confirm(): void
  }
  class ArtistRequestsStore {
    +tab: Signal<RequestsTab>
    +query: Signal<string>
    +requests: Signal<ArtistRequest[]>
    +load(): void
  }
  class ArtistBookingStore {
    +booking: Signal<ArtistBookingDetail | null>
    +busy: Signal<boolean>
    +load(number: string): void
    +accept(): void
    +decline(reason: DeclineReason | null, note: string): void
  }
  class ArtistRequestsApi {
    +list(tab: RequestsTab, query?: string, cursor?: string): Observable<Page<ArtistRequest>>
    +accept(number: string): Observable<void>
    +decline(number: string, reason?: DeclineReason, note?: string): Observable<void>
  }
}

package "Zamaro API (Laravel)" {
  class ArtistRequestsController {
    +index(): ResourceCollection
    +accept(request: AcceptBookingRequest, booking: Booking): JsonResponse
    +decline(request: DeclineBookingRequest, booking: Booking): JsonResponse
  }
  class DeclineBookingRequest <<FormRequest>> {
    +rules(): array
  }
  class ListArtistRequests <<action>> {
    +handle(artist: Artist, cursor: ?string): CursorPaginator
  }
  class ArtistRequestResource <<API resource>> {
    +string number
    +string churchName
    +string city
    +Distance distance
    +string eventDate
    +GatheringKind gatheringKind
    +string startTime
    +?string message
    +int quotedPriceCents
    +int payoutCents
    +string respondBy
  }
  class AcceptBooking <<action>> {
    +handle(booking: Booking, artistUser: User): Booking
  }
  class DeclineBooking <<action>> {
    +handle(booking: Booking, artistUser: User, reason: ?DeclineReason, note: ?string): Booking
  }
  enum DeclineReason {
    NotFree
    TooFar
    NotRightFit
    Other
  }
  class BookingStateMachine {
    +transition(booking: Booking, to: BookingStatus, actor: TransitionActor, reason: ?string): BookingTransition
  }
  class SimilarArtistFinder {
    +freeOn(artist: Artist, date: CarbonImmutable, church: Church, limit: int): Artist[]
  }
  class DistanceService {
    +between(from: Coordinates, to: Coordinates): Distance
  }
  class PriceBreakdown <<value object>> {
    +{static} forBooking(booking: Booking): PriceBreakdown
    +int totalCents
    +int feeCents
    +int artistPayoutCents
  }
  class Booking <<Eloquent>> {
    +string number
    +BookingStatus status
    +CarbonImmutable respondBy
    +?CarbonImmutable acceptedAt
    +?CarbonImmutable depositDueBy
    +?DeclineReason declineReason
    +?string declineNote
  }
  class RequestDeclined <<event>> {
    +int bookingId
    +?DeclineReason reason
    +?string note
  }
}

ArtistRequestsPage --> ArtistRequestsStore
ArtistRequestsPage *-- RequestRowComponent
RequestRowComponent ..> ArtistBookingPage : links to /artist/bookings/:number
ArtistBookingPage --> ArtistBookingStore
ArtistBookingPage ..> AcceptRequestDialogComponent : opens
ArtistBookingPage ..> DeclineRequestDialogComponent : opens
ArtistRequestsStore --> ArtistRequestsApi
ArtistBookingStore --> ArtistRequestsApi
ArtistRequestsApi ..> ArtistRequestsController : /api/v1/artist/requests
ArtistRequestsController --> ListArtistRequests
ArtistRequestsController --> AcceptBooking
ArtistRequestsController --> DeclineBooking
ArtistRequestsController ..> DeclineBookingRequest : validates
ListArtistRequests ..> ArtistRequestResource : builds
ListArtistRequests --> DistanceService
ListArtistRequests --> PriceBreakdown
AcceptBooking --> BookingStateMachine
DeclineBooking --> BookingStateMachine
BookingStateMachine ..> Booking : updates
BookingStateMachine ..> RequestDeclined : dispatches
RequestDeclined ..> SimilarArtistFinder : listener uses
@enduml
