@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View the artist dashboard

Person(artist, "Artist", "Approved worship artist")
Person(booker, "Booker", "Signed-in church representative")
System_Ext(routing, "Routing provider", "Driving distance")
System_Boundary(zamaro, "Zamaro") {
  Container(web, "Zamaro Web", "Angular with SSR", "Dashboard at /artist inside the artist shell")
  Container(api, "Zamaro API", "PHP 8.3 / Laravel 11", "GET /api/v1/artist/dashboard")
  ContainerDb(db, "Zamaro database", "PostgreSQL 16", "Bookings, availability, artists, media, setlist, reviews, ratings")
  ContainerDb(cache, "Cache and queue", "Redis", "Distance cache")
}
Rel(artist, web, "Uses", "HTTPS")
Rel(booker, web, "Opens /artist", "HTTPS")
Rel(web, api, "GET /api/v1/artist/dashboard", "JSON/HTTPS")
Rel(api, db, "Reads the artist's own rows; writes nothing", "Eloquent / SQL")
Rel(api, cache, "Reads cached church distances", "RESP")
Rel(api, routing, "Measures an uncached distance", "HTTPS/JSON")
@enduml
