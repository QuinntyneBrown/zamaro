@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Suggest alternatives when sold out

package "Zamaro Web (Angular)" {
  class SoldOut {
    +title: Signal<string>
    +explanation: Signal<string>
    +nearbyDates: Signal<DateSwapOption[]>
    +wider: Signal<{ km, label } | null>
    #pickDate(date: string): void
    #widen(km: RadiusKm): void
    #showAllStyles(): void
  }
  class "zm-empty-state" as EmptyState <<library>>
  class "zm-date-swap" as DateSwap <<library>> {
    +options: InputSignal<DateSwapOption[]>
    +pick: OutputEmitterRef<string>
  }
  class SearchStore {
    +alternatives: Signal<SearchAlternatives | null>
    +navigate(change: Partial<SearchState>, options): void
  }
  interface DiscoveryApi {
    +alternatives(query: SearchQuery): Observable<SearchAlternatives>
  }
  class FormatService {
    +dateDescription(date: CalendarDate): string
  }
}

package "Zamaro API (Laravel)" {
  class SearchAlternativesController {
    +__invoke(request: SearchArtistsRequest, find: FindSearchAlternatives): JsonResponse
  }
  class FindSearchAlternatives <<action>> {
    +handle(criteria: SearchCriteria): SearchAlternatives
    -nearbyDates(criteria, candidates, ids): array
    -widerRadius(criteria, candidates, ids, wider): ?array
    -countFree(candidates, ids, date, criteria, radiusKm): int
  }
  class CandidateFinder {
    +measured(criteria: SearchCriteria, boxRadiusKm: int): LineupCard[]
    +{static} travels(card: LineupCard, radiusKm: int): bool
  }
  class AvailabilityService {
    +freeArtistIds(artistIds: array, date: CarbonImmutable, kind: GatheringKind): array
  }
  class DistanceService {
    +fromOrigin(origin: Coordinates, destinations: array): Distance[]
  }
  class SearchAlternatives <<value object>> {
    +array nearbyDates: {date, count}[0..3]
    +?array widerRadius: {km, count}
    +bool filtersApplied
  }
}

SoldOut --> EmptyState
SoldOut --> DateSwap
SoldOut ..> SearchStore : navigate()
SoldOut ..> FormatService : uses
SearchStore --> DiscoveryApi
DiscoveryApi ..> SearchAlternativesController : GET /api/v1/search/alternatives
SearchAlternativesController --> FindSearchAlternatives
FindSearchAlternatives --> CandidateFinder
FindSearchAlternatives --> AvailabilityService
CandidateFinder --> DistanceService
FindSearchAlternatives ..> SearchAlternatives : builds
@enduml
