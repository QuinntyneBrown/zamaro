@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Suggest alternatives when sold out

Container(web, "Zamaro Web", "Angular", "SoldOutComponent, SearchStore, SearchApi")
Container_Boundary(api, "Zamaro API") {
  Component(ctrl, "SearchAlternativesController", "Laravel controller", "Exposes GET /api/v1/search/alternatives")
  Component(req, "SearchArtistsRequest", "FormRequest", "Validates the same search inputs")
  Component(action, "FindSearchAlternatives", "Action", "Counts matches per nearby date and wider radius")
  Component(avail, "AvailabilityService", "Domain service", "Free artist IDs for each date in a range")
  Component(dist, "DistanceService", "Domain service", "Road distance with cache and fallback")
  Component(explain, "SoldOutExplainer", "Domain service", "Chooses the explanation sentence")
  Component(res, "SearchAlternativesResource", "API resource", "Serialises nearby dates, wider radius, explanation")
  ComponentDb(db, "Zamaro database", "PostgreSQL 16", "Artists, rules, overrides, bookings")
  ComponentDb(cache, "Cache and queue", "Redis", "Distance cache")
}
Rel(web, ctrl, "GET /api/v1/search/alternatives", "JSON/HTTPS")
Rel(ctrl, req, "Validates with")
Rel(ctrl, action, "Calls")
Rel(action, db, "Loads filtered candidates in widest bounding box", "SQL")
Rel(action, dist, "Measures each candidate once")
Rel(dist, cache, "Reads and writes", "RESP")
Rel(action, avail, "freeArtistIdsByDate()")
Rel(avail, db, "Reads the 15-day range", "SQL")
Rel(action, explain, "Words the explanation with")
Rel(ctrl, res, "Returns")
@enduml
