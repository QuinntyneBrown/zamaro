@startuml
title UML sequence behaviour — Show the sold-out state
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Booker or guest" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "Discover and SearchForm" as page
  participant "SearchStore" as store
  participant "DiscoveryApi" as client
  participant "SoldOut" as soldout
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "SearchAlternativesController" as controller
end box
box "Backend — Zamaro Application and Domain" #ECFDF3
  participant "FindSearchAlternatives" as action
  participant "CandidateFinder" as finder
  participant "DistanceService" as dist
  participant "AvailabilityService" as avail
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database" as db
  database "Cache and queue" as cache
end box

actor -> page : Activate "Show the lineup" for Thu 24 Dec, 40 km, Gospel choir
page -> store : load(state from the address bar)
store -> client : search(query)
client --> store : SearchResult with total = 0
store -> soldout : Show "Nobody's free Christmas Eve within 40 km" (L2-011)
store -> client : alternatives(query)
client -> controller : GET /api/v1/search/alternatives?date&kind&lat&lng&radius&styles
controller -> controller : Rate-limit and validate SearchArtistsRequest
controller -> action : handle(SearchCriteria)
action -> finder : measured(criteria, largest wider radius)
finder -> db : Filtered candidates inside the bounding box
db --> finder : Candidates
finder -> dist : fromOrigin(church location, candidates' bases)
dist -> cache : Get cached pairs
cache --> dist : Distances (provider call on a miss)
dist --> finder : Distances
finder --> action : Measured candidates
loop each date 1 to 7 days either side, closest first, until 3 dates
  action -> avail : freeArtistIds(candidates, date, kind)
  avail -> db : Rules, overrides, Confirmed bookings, VSC for that date
  db --> avail : Blocking dates
  avail --> action : Free IDs
  action -> action : Count travel-matched free artists; keep the date when above 0 (L2-011)
end
action -> action : Count per wider radius on the searched date; keep smallest non-zero (L2-011)
action --> controller : SearchAlternatives
controller --> client : 200 nearbyDates, widerRadius, filtersApplied
client --> store : SearchAlternatives
store -> soldout : Render the explanation from catalogue templates, nearby dates (zm-date-swap),\n"Search within 120 km · 2 free" and "Show all styles"
soldout --> actor : Sold-out state with ways forward
@enduml
