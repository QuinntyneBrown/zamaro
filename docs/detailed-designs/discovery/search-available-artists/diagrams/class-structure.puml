@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Search available artists

package "Zamaro Web (Angular)" {
  class Discover <<page>> {
    +store: SearchStore
  }
  class SearchForm {
    +submit(): Promise<void>
  }
  class Lineup {
    +showMore(): Promise<void>
  }
  class SearchStore {
    +state: Signal<SearchState>
    +query: Signal<SearchQuery | null>
    +result: Signal<SearchResult | null>
    +status: Signal<'idle'|'loading'|'loaded'|'error'|'limited'>
    +load(state: SearchState, search: boolean): void
    +navigate(change: Partial<SearchState>, options): void
    +retry(): void
    +loadMore(): Promise<number>
  }
  interface DiscoveryApi {
    +search(query: SearchQuery): Observable<SearchResult>
    +lookUpPlace(text: string): Observable<Place | null>
  }
  class HttpDiscoveryApi
}

package "Zamaro API (Laravel)" {
  class SearchController {
    +__invoke(request: SearchArtistsRequest, search: SearchAvailableArtists): LineupCardResource[]
  }
  class SearchArtistsRequest {
    +rules(): array
    +criteria(): SearchCriteria
    +cursorKey(): ?array
  }
  class SearchCriteria <<value object>> {
    +CarbonImmutable eventDate
    +Coordinates location
    +GatheringKind kind
    +int radiusKm
  }
  class SearchAvailableArtists <<action>> {
    +handle(criteria: SearchCriteria, after: ?array): Lineup
  }
  class HeadlinerPicker {
    +pick(cards: LineupCard[], today: CarbonImmutable): ?LineupCard
    +quoteFor(headliner: LineupCard): ?HeadlinerQuote
  }
  class AvailabilityService {
    +freeArtistIds(artistIds: array, date: CarbonImmutable, kind: GatheringKind): array
  }
  class DistanceService {
    +fromOrigin(origin: Coordinates, destinations: array): Distance[]
  }
  interface RoutingProvider {
    +matrix(origin: Coordinates, destinations: array): array
  }
  class Distance <<value object>> {
    +int km
    +int driveMinutes
    +bool approximate
  }
  class Lineup <<value object>> {
    +?LineupCard headliner
    +?HeadlinerQuote quote
    +LineupCard[] tickets
    +int total
    +Season season
    +?string nextCursor
  }
  class LineupCard <<value object>> {
    +Artist artist
    +Distance distance
  }
  class LineupCardResource <<API resource>>
  class HeadlinerResource <<API resource>>
  class Artist <<Eloquent>> {
    +int id
    +string slug
    +string display_name
    +string act_type
    +string base_city
    +float base_latitude
    +float base_longitude
    +int max_drive_km
    +int from_price_cents
    +ArtistStatus status
  }
  enum GatheringKind {
    SundayService
    WorshipNight
    YouthEvent
    ConferenceOrRetreat
    Wedding
    FuneralOrMemorial
  }
}

Discover --> SearchForm
Discover --> Lineup
SearchForm --> SearchStore
Lineup --> SearchStore
SearchStore --> DiscoveryApi
HttpDiscoveryApi ..|> DiscoveryApi
HttpDiscoveryApi ..> SearchController : GET /api/v1/search
SearchController ..> SearchArtistsRequest : validates
SearchArtistsRequest ..> SearchCriteria : creates
SearchController --> SearchAvailableArtists
SearchController ..> LineupCardResource : tickets
SearchController ..> HeadlinerResource : headliner
SearchAvailableArtists --> AvailabilityService
SearchAvailableArtists --> DistanceService
SearchAvailableArtists --> HeadlinerPicker
DistanceService --> RoutingProvider
DistanceService ..> Distance : returns
SearchAvailableArtists ..> Lineup : builds
Lineup "1" *-- "0..24" LineupCard
LineupCard --> Artist
LineupCard --> Distance
SearchCriteria --> GatheringKind
@enduml
