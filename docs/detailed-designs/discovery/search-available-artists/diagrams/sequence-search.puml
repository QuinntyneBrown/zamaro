@startuml
title UML sequence behaviour — Search available artists
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Booker or guest" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "SearchForm and Lineup" as page
  participant "SearchStore" as store
  participant "DiscoveryApi" as client
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "SearchController" as controller
end box
box "Backend — Zamaro Application and Domain" #ECFDF3
  participant "SearchAvailableArtists" as action
  participant "AvailabilityService" as avail
  participant "DistanceService" as dist
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database" as db
  database "Cache and queue" as cache
  participant "Routing provider" as routing
end box

actor -> page : Activate "Show the lineup"
page -> page : Validate date window and required fields (L2-004)
alt invalid input
  page --> actor : Inline errors, focus first invalid field, no search
else valid input
  page -> store : navigate(criteria)
  store -> store : Write the criteria to the address bar;\nDiscover hands them back through load() (L2-009)
  store -> store : Set status loading, aria-busy after 300 ms (L2-105)
  store -> client : search(query)
  client -> controller : GET /api/v1/search?date&kind&lat&lng&radius&sort
  controller -> controller : Rate-limit and validate SearchArtistsRequest (L2-004, L2-077)
  controller -> action : handle(SearchCriteria, cursor key)
  action -> db : Approved, published, payout-ready artists in bounding box of radius
  db --> action : Candidate artists
  action -> avail : freeArtistIds(candidates, date, kind) (L2-005)
  avail -> db : Overrides, weekly rules, Confirmed bookings, VSC for Youth events
  db --> avail : Blocking dates
  avail --> action : Free artist IDs
  action -> dist : fromOrigin(church location, free artists' bases) (L2-002)
  dist -> cache : Get each pair rounded to 4 decimals
  alt any cache miss
    dist -> routing : matrix(church location, missed bases)
    alt provider unavailable
      dist -> dist : Straight line x 1.3, mark "about", log routing.unavailable
    else success
      routing --> dist : Metres and seconds
      dist -> cache : Store each pair for 30 days
    end
  end
  dist --> action : Distance per artist (km, minutes)
  action -> action : Keep distance <= radius and <= artist max drive (L2-003)
  action -> action : Pick headliner: most bookings confirmed this season,\nthen rating, distance, artist ID (L2-006)
  action -> action : Sort the rest Closest first, number from No. 02,\nfirst page of 24 cards with the headliner (L2-007, L2-010)
  action --> controller : Lineup
  controller --> client : 200 LineupCardResource collection with headliner and meta
  client --> store : SearchResult
  store --> page : Render poster date, summary line and ticket cards
  page --> actor : Lineup shown without page reload (L2-004)
end
@enduml
