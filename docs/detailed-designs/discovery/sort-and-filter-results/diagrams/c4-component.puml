@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Sort and filter results

Person(booker, "Booker or guest", "Narrows and orders the lineup")
Container_Boundary(web, "Zamaro Web") {
  Component(page, "Discover", "Angular page", "Hosts the poster and lineup; reacts to query params")
  Component(lineup, "Lineup", "Angular component", "Sort select (zm-form-field), style and price chips (zm-chip), summary line announced politely")
  Component(codec, "search-query-codec", "Pure functions", "SearchState to query params and back, with defaults")
  Component(store, "SearchStore", "Signal store", "Holds the state; navigates and runs searches")
  Component(client, "DiscoveryApi", "Typed HTTP client", "GET /api/v1/search")
}
Container_Boundary(api, "Zamaro API") {
  Component(req, "SearchArtistsRequest", "FormRequest", "Validates sort, styles and price")
  Component(action, "SearchAvailableArtists", "Action", "Filters, measures, travel-matches, sorts")
  Component(filter, "LineupFilter", "Value object", "Styles (any) AND price under $800")
  Component(sorter, "LineupSorter", "Domain service", "One comparator per SearchSort")
  ComponentDb(db, "Zamaro database", "PostgreSQL 16", "artists, artist_styles, reviews")
}
Rel(booker, lineup, "Toggles chips, picks sort", "HTTPS")
Rel(page, lineup, "Contains")
Rel(lineup, store, "Calls navigate() with the changed part")
Rel(page, store, "Hands each decoded state to load()")
Rel(store, codec, "Encodes and decodes state with")
Rel(store, client, "Searches with")
Rel(client, req, "GET /api/v1/search", "JSON/HTTPS")
Rel(req, action, "Passes SearchCriteria to")
Rel(action, filter, "Applies in SQL pre-filter")
Rel(action, db, "Queries candidates", "SQL")
Rel(action, sorter, "Orders cards with")
@enduml
