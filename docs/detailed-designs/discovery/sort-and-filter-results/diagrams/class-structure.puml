@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Sort and filter results

package "Zamaro Web (Angular)" {
  class SearchState <<interface>> {
    +date: string
    +kind: GatheringKind
    +lat: number | null
    +lng: number | null
    +place: string
    +radius: 40|80|120|200
    +sort: 'closest'|'rating'|'price'
    +styles: Style[]
    +under800: boolean
  }
  class "search-query-codec" as SearchQueryCodec <<module>> {
    +toParams(state: SearchState): Params
    +fromParams(params: ParamMap): SearchState
    +toQuery(state: SearchState): SearchQuery | null
  }
  class SearchStore {
    +state: Signal<SearchState>
    +result: Signal<SearchResult | null>
    +load(state: SearchState, search: boolean): void
    +navigate(change: Partial<SearchState>, options): void
  }
  class Lineup {
    +sortControl: FormControl<SearchSort>
    +kicker: Signal<string>
    +toggleStyle(style: Style): void
    +toggleUnder800(): void
    -announcer: LiveAnnouncer
  }
  class Discover <<page>>
}

package "Zamaro API (Laravel)" {
  class SearchArtistsRequest {
    +rules(): array
    +criteria(): SearchCriteria
    +cursorKey(): ?array
  }
  class SearchCriteria <<value object>> {
    +CarbonImmutable eventDate
    +Coordinates location
    +GatheringKind kind
    +int radiusKm
    +LineupFilter filter
    +SearchSort sort
  }
  enum SearchSort {
    Closest
    HighestRated
    PriceLowToHigh
  }
  class LineupFilter <<value object>> {
    +Style[] styles
    +bool under800
    +applyTo(artists: Builder): void
  }
  enum Style {
    Band
    SoloVocalist
    GospelChoir
    Acoustic
    Hymns
    Spanish
  }
  class SearchAvailableArtists <<action>> {
    +handle(criteria: SearchCriteria, after: ?array): Lineup
  }
  class LineupSorter {
    +sort(cards: LineupCard[], sort: SearchSort): LineupCard[]
    +key(card: LineupCard, sort: SearchSort): array
  }
  class "Lineup" as ApiLineup <<value object>> {
    +?LineupCard headliner
    +LineupCard[] tickets
    +int total
    +?string nextCursor
  }
}

Lineup ..> SearchStore : navigate()
Discover ..> SearchStore : load()
Discover ..> SearchQueryCodec : fromParams()
SearchStore --> SearchQueryCodec
SearchQueryCodec ..> SearchState : encodes / decodes
SearchStore ..> SearchArtistsRequest : GET /api/v1/search
SearchArtistsRequest ..> SearchCriteria : creates
SearchCriteria --> SearchSort
SearchCriteria *-- LineupFilter
LineupFilter --> "0..6" Style
SearchAvailableArtists ..> SearchCriteria : handles
SearchAvailableArtists --> LineupSorter
SearchAvailableArtists ..> ApiLineup : builds
@enduml
