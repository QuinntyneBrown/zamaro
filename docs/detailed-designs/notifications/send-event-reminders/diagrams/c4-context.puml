@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Send event reminders

Person(booker, "Booker", "Signed-in church representative")
Person(artist, "Artist", "Approved worship artist")
System(zamaro, "Zamaro", "Books Christian praise and worship artists around Toronto")
System_Ext(email, "Email delivery service", "Transactional email")

Rel(zamaro, email, "Sends 7-day and 1-day reminders via", "HTTPS/JSON")
Rel(email, booker, "Delivers reminders to")
Rel(email, artist, "Delivers reminders to")
Rel(booker, zamaro, "Opens the message thread using", "HTTPS")
Rel(artist, zamaro, "Opens the message thread using", "HTTPS")
@enduml
