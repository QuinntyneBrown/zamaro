@startuml
title UML sequence behaviour — Render the shell and open a dialog on a phone
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Booker on a phone (XS)" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "Shell" as shell
  participant "BreakpointService" as bp
  participant "zm-top-bar" as topbar
  participant "MenuDialog" as drawer
  participant "DialogService" as dialogs
  participant "CurrentUserStore" as users
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "MeController" as me
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database" as db
end box

actor -> shell : Open any page at 360 px
shell -> topbar : Render the header; CSS shows the compact form below LG (L2-099)
note over bp : Later: BreakpointService, for behaviour CSS cannot express
topbar -> users : load() (M2, signed-in bookers)
users -> me : GET /api/v1/me
me -> db : User and Saved count
db --> me : Row and count
me --> users : 200 MeResource
users --> topbar : initials, savedCount
topbar --> actor : Brand, menu button, Saved count and initials visible (L2-099)
shell --> actor : One-column reflow, no horizontal scroll, 44 px targets (L2-096)
actor -> topbar : Activate menu button
topbar -> shell : menuOpened
shell -> drawer : openMenuDialog(), aria-expanded = true
drawer --> actor : Discover, How booking works, For artists, Dark theme toggle
actor -> drawer : Choose a link
drawer -> drawer : Close on NavigationEnd, return focus to menu button
opt a dialog opens on the new page
  actor -> dialogs : Activate a control that opens a dialog
  dialogs -> bp : viewportClass()
  bp --> dialogs : xs
  dialogs -> dialogs : Open the design-system dialog, full screen at XS (L2-099)
  dialogs --> actor : Dialog fills the screen, close button pinned at the top
end
@enduml
