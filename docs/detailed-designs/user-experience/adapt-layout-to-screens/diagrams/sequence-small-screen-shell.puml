@startuml
title UML sequence behaviour — Render the shell and open a dialog on a phone
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Booker on a phone (XS)" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "AppShellComponent" as shell
  participant "BreakpointService" as bp
  participant "TopBarComponent" as topbar
  participant "NavDrawerComponent" as drawer
  participant "DialogService" as dialogs
  participant "CurrentUserStore" as users
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "MeController" as me
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database" as db
end box

actor -> shell : Open any page at 360 px
shell -> bp : viewportClass()
bp --> shell : xs (SSR default, confirmed by matchMedia)
shell -> topbar : Render compact header (L2-099)
topbar -> users : load()
users -> me : GET /api/v1/me
me -> db : User and Saved count
db --> me : Row and count
me --> users : 200 MeResource
users --> topbar : initials, savedCount
topbar --> actor : Brand, menu button, Saved count and initials visible (L2-099)
shell --> actor : One-column reflow, no horizontal scroll, 44 px targets (L2-096)
actor -> topbar : Activate menu button
topbar -> drawer : Open, aria-expanded = true
drawer --> actor : Discover, How booking works, For artists
actor -> drawer : Choose a link
drawer -> drawer : Close on NavigationEnd, return focus to menu button
opt a dialog opens on the new page
  actor -> dialogs : Activate a control that opens a dialog
  dialogs -> bp : viewportClass()
  bp --> dialogs : xs
  dialogs -> dialogs : Apply dialog--fullscreen panel class (L2-099)
  dialogs --> actor : Dialog fills the screen, close button pinned at the top
end
@enduml
