@startuml
title UML sequence behaviour — Start a production process with secrets
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Deployment platform" as platform
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "DiscoverPage" as page
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "Zamaro API process" as api
  participant "HealthController" as health
end box
box "Backend — Zamaro Application and Domain" #ECFDF3
  participant "ProductionSafetyServiceProvider" as safety
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  participant "Secrets manager" as secrets
  participant "Edge load balancer" as edge
end box

platform -> secrets : Read zamaro/production secret set (L2-078)
secrets --> platform : DB password, APP_KEY, FIELD_ENCRYPTION_KEY, provider secrets
platform -> api : Start container with secrets in process environment (no .env file)
api -> safety : boot()
alt APP_DEBUG true or a required secret missing (L2-078)
  safety --> api : throw UnsafeProductionConfiguration
  api --> platform : Process exits, never ready
  platform -> platform : Keep previous release serving (L2-094)
else configuration safe
  safety --> api : OK
  edge -> health : GET /health/ready
  health --> edge : 200 when database, cache and queue reachable (L2-090)
  edge -> edge : Add instance to API pool
  page -> edge : GET /api/v1/search
  edge -> api : Forward
  api --> page : 200 from the new release
end
@enduml
