@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Protect secrets and data

Person(booker, "Booker", "Saves church contact details")
System(zamaro, "Zamaro", "Books Christian praise and worship artists around Toronto")
System_Ext(secrets, "Secrets manager", "Runtime secrets and field keys; vendor <TO SUPPLY>")
System_Ext(errors, "Error tracking service", "Receives redacted exceptions")
