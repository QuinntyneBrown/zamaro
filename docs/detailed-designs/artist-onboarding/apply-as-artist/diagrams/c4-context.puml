@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Apply as an artist

Person(applicant, "Artist applicant", "Person applying to join as an artist")
System(zamaro, "Zamaro", "Books Christian praise and worship artists around Toronto")
System_Ext(bot, "Bot challenge provider", "Privacy-respecting challenge")
System_Ext(geo, "Geocoding provider", "Address to latitude and longitude")
System_Ext(routing, "Routing provider", "Driving distance and drive time")
System_Ext(scanner, "Malware scanner", "Scans every upload")
System_Ext(video, "Video processing service", "Transcodes uploads to streaming renditions")
System_Ext(email, "Email delivery service", "Transactional email")

Rel(applicant, zamaro, "Submits an application with videos and references using", "HTTPS")
Rel(zamaro, bot, "Verifies the challenge token with", "HTTPS/JSON")
Rel(zamaro, geo, "Geocodes the base city with", "HTTPS/JSON")
Rel(zamaro, routing, "Measures road distance from Toronto City Hall with", "HTTPS/JSON")
Rel(zamaro, scanner, "Scans uploaded videos with")
Rel(zamaro, video, "Transcodes application videos with", "HTTPS/JSON")
Rel(zamaro, email, "Sends the application-received email through", "HTTPS")
@enduml
