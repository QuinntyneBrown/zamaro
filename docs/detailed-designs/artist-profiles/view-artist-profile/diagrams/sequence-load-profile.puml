@startuml
title UML sequence behaviour — Load an artist profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Booker or guest" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "ArtistPage" as page
  participant "ArtistProfileStore" as store
  participant "ArtistProfilesApi" as client
  participant "zm-artist-poster" as header
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "ArtistProfileController" as controller
  participant "ArtistProfileResource" as res
end box
box "Backend — Zamaro Application and Domain" #ECFDF3
  participant "ShowArtistProfile" as action
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database" as db
end box

actor -> page : Open /artists/abigail-mensah?date=2026-11-14
page -> store : load(slug)
store -> store : Skeletons and aria-busy after 300 ms (L2-105)
store -> client : get(slug)
client -> controller : GET /api/v1/artists/abigail-mensah
controller -> action : handle(slug)
action -> db : Visible artist by slug with styles, setlist and visible-review aggregate
db --> action : Rows (photos and Live videos join with S12; L2-014)
action --> controller : Artist, or 404 (the 301 for a renamed slug arrives with S15)
controller -> res : Serialise public fields only; base city, no address, email or phone (L2-083)
res --> controller : JSON
controller --> client : 200 ArtistProfileResource, Cache-Control public, s-maxage=60
client --> store : ArtistProfile (carried by the HTTP transfer cache after the server render)
store --> page : status = loaded
page -> header : Kicker, name, rating or "New · No reviews yet", city, "Drives up to 120 km";\nzm-marquee shows the first 5 songs (L2-012)
alt carried date present
  header --> actor : Back link "Discover · Sat 14 Nov"; Book button "Book for Sat 14 Nov" (L2-012)
else no carried date
  header --> actor : Book button "Check dates" focuses the stub date field (L2-012)
end
page -> page : About as plain-text paragraphs, markup never executed (L2-013)
page -> page : Setlist (zm-setlist); videos and gallery or their empty states join with S12\n(L2-014, L2-015, L2-016, L2-020)
page -> page : Layout for the current breakpoint (L2-098)
page --> actor : Profile shown
@enduml
