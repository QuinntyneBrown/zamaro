@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — View an artist profile

package "Zamaro Web (Angular)" {
  class ArtistPage <<page>> {
    -date: Signal<CalendarDate | null>
    #book(): void
  }
  class ArtistProfileStore {
    +profile: Signal<ArtistProfile | null>
    +status: Signal<'loading'|'loaded'|'error'>
    +showSkeletons: Signal<boolean>
    +load(slug: string): void
    +retry(): void
  }
  interface ArtistProfilesApi {
    +get(slug: string): Observable<ArtistProfile>
  }
  class "zm-artist-poster" as ArtistPoster <<library>> {
    +name: InputSignal<string>
    +art: InputSignal<'solo'|'group'|null>
    +loading: InputSignal<boolean>
  }
  class "zm-alert" as Alert <<library>>
  class PhotoViewerDialog <<S12>> {
    +photos: ProfilePhoto[]
    +index: WritableSignal<number>
    +previous(): void
    +next(): void
  }
}

package "Zamaro API (Laravel)" {
  class ArtistProfileController {
    +show(request: Request, profiles: ShowArtistProfile, slug: string): JsonResponse
  }
  class ShowArtistProfile <<action>> {
    +handle(slug: string): Artist
  }
  class ArtistProfileResource <<API resource>> {
    +string slug
    +string displayName
    +string firstName
    +Pronoun pronoun
    +string actType
    +string headline
    +?string aboutHeading
    +string bio
    +string baseCity
    +int maxDriveKm
    +int fromPriceCents
    +string ticketNumber
    +?float rating
    +int reviewCount
    +Style[] styles
    +SetlistSong[] setlist
    +toArray(request: Request): array
  }
  class ProfilePhoto <<value object>> {
    +string altText
    +bool primary
    +array srcset
    +int width
    +int height
  }
  class ProfileVideo <<value object>> {
    +string title
    +int durationSeconds
    +string posterUrl
    +string manifestUrl
    +?string captionsUrl
  }
  class SetlistSong <<Eloquent>> {
    +int position
    +string title
    +?string writer
    +string key
  }
  enum Pronoun {
    She
    He
    They
  }
  class Artist <<Eloquent>> {
    +int id
    +string slug
    +string displayName
    +ArtistStatus status
    +?CarbonImmutable publishedAt
  }
  class MediaUrlSigner {
    +imageSrcset(photo: ArtistPhoto): array
    +videoManifest(video: ArtistVideo): string
  }
}

ArtistPage --> ArtistProfileStore
ArtistPage --> ArtistPoster
ArtistPage ..> Alert : shows on error
ArtistPage ..> PhotoViewerDialog : opens (S12)
ArtistProfileStore --> ArtistProfilesApi
ArtistProfilesApi ..> ArtistProfileController : GET /api/v1/artists/{slug}
ArtistProfileController --> ShowArtistProfile
ShowArtistProfile ..> Artist : reads
ArtistProfileController ..> ArtistProfileResource : returns
ArtistProfileResource ..> Artist : serialises public fields
ArtistProfileResource ..> ArtistProfile : serialises public fields
ArtistProfileResource --> MediaUrlSigner
ArtistProfile "1" *-- "0..12" ProfilePhoto
ArtistProfile "1" *-- "0..8" ProfileVideo
ArtistProfile "1" o-- "0..50" SetlistSong
ArtistProfile --> Pronoun
@enduml
