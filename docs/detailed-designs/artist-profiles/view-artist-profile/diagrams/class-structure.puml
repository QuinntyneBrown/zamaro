@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — View an artist profile

package "Zamaro Web (Angular)" {
  class ArtistProfilePage {
    +slug: InputSignal<string>
    +date: InputSignal<string | null>
    +onBook(): void
  }
  class ArtistProfileStore {
    +profile: Signal<ArtistProfile | null>
    +carriedDate: Signal<string | null>
    +status: Signal<'loading'|'loaded'|'error'>
    +selectedDate: WritableSignal<string | null>
    +messageDraft: WritableSignal<string>
    +load(slug: string, date: string | null): void
    +retry(): void
    +askForRecording(): void
  }
  class ArtistProfileApi {
    +get(slug: string): Observable<ArtistProfile>
  }
  class PhotoViewerDialogComponent {
    +photos: ProfilePhoto[]
    +index: WritableSignal<number>
    +previous(): void
    +next(): void
  }
  class ProfileErrorComponent {
    +lineupUrl: InputSignal<string>
    +retry: OutputEmitterRef<void>
  }
}

package "Zamaro API (Laravel)" {
  class ArtistProfileController {
    +show(slug: string): ArtistProfileResource
  }
  class ShowArtistProfile <<action>> {
    +handle(artist: Artist): ArtistProfile
  }
  class ArtistProfile <<value object>> {
    +string slug
    +string displayName
    +string firstName
    +Pronoun pronoun
    +string actType
    +string headline
    +string bio
    +string baseCity
    +int maxDriveKm
    +int fromPriceCents
    +string ticketNumber
    +?float rating
    +int reviewCount
    +Style[] styles
  }
  class ArtistProfileResource {
    +toArray(request: Request): array
  }
  class ProfilePhoto <<value object>> {
    +string altText
    +bool primary
    +array srcset
    +int width
    +int height
  }
  class ProfileVideo <<value object>> {
    +string title
    +int durationSeconds
    +string posterUrl
    +string manifestUrl
    +?string captionsUrl
  }
  class SetlistSong <<Eloquent>> {
    +int position
    +string title
    +?string writerOrSource
    +string key
  }
  enum Pronoun {
    SheHer
    HeHim
    TheyThem
    +objective(): string
    +possessive(): string
  }
  class Artist <<Eloquent>> {
    +int id
    +string slug
    +string displayName
    +ArtistStatus status
    +?CarbonImmutable publishedAt
  }
  class MediaUrlSigner {
    +imageSrcset(photo: ArtistPhoto): array
    +videoManifest(video: ArtistVideo): string
  }
}

ArtistProfilePage --> ArtistProfileStore
ArtistProfileStore --> ArtistProfileApi
ArtistProfilePage ..> PhotoViewerDialogComponent : opens
ArtistProfilePage ..> ProfileErrorComponent : shows on error
ArtistProfileApi ..> ArtistProfileController : GET /api/v1/artists/{slug}
ArtistProfileController --> ShowArtistProfile
ShowArtistProfile ..> Artist : reads
ShowArtistProfile ..> ArtistProfile : builds
ArtistProfileController ..> ArtistProfileResource : returns
ArtistProfileResource ..> ArtistProfile : serialises public fields
ArtistProfileResource --> MediaUrlSigner
ArtistProfile "1" *-- "0..12" ProfilePhoto
ArtistProfile "1" *-- "0..8" ProfileVideo
ArtistProfile "1" o-- "0..50" SetlistSong
ArtistProfile --> Pronoun
@enduml
