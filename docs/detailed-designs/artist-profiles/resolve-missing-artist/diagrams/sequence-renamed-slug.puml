@startuml
title UML sequence behaviour — Renamed slug
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Booker, guest or crawler" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "ArtistProfileStore" as store
  participant "HttpArtistProfilesApi" as client
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "ArtistProfileController" as controller
  participant "ProblemDetailsRenderer" as renderer
end box
box "Backend — Zamaro Application and Domain" #ECFDF3
  participant "ResolveArtistSlug" as resolve
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database" as db
end box

actor -> store : GET /artists/abigail-sings?date=2026-11-14 (server render)
store -> client : get('abigail-sings', { date })
client -> controller : GET /api/v1/artists/abigail-sings?date=2026-11-14
controller -> resolve : handle(slug)
resolve -> db : artists.slug = old slug
db --> resolve : No row
resolve -> db : slug_histories.slug = old slug, retired_at set
db --> resolve : The artist, viewable, now abigail-mensah
resolve --> renderer : throw ArtistMoved('abigail-mensah')
renderer --> client : 301 Location: /api/v1/artists/abigail-mensah?date=2026-11-14 (L2-021, L2-055)
client -> controller : GET /api/v1/artists/abigail-mensah?date=2026-11-14 (fetch follows the redirect)
controller --> client : 200 ArtistProfileResource with slug abigail-mensah
client --> store : Profile whose slug differs from the route slug
store -> store : HttpStatus.set(301); router.navigate(current slug, query kept, replaceUrl)
alt server render
  store --> actor : 301 Location: /artists/abigail-mensah?date=2026-11-14 (Angular SSR turns the navigation into the redirect)
else browser navigation
  store --> actor : Address replaced; the profile loads at the current slug
end
@enduml
