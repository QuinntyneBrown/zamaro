@startuml
title UML sequence behaviour — Missing, suspended or deleted artist
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Booker or guest" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "ArtistProfilePage" as page
  participant "ArtistProfileApi" as client
  participant "ArtistNotFoundComponent" as notfound
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "ArtistProfileController" as controller
  participant "ArtistNotFound" as ex
end box
box "Backend — Zamaro Application and Domain" #ECFDF3
  participant "ResolveArtistSlug" as resolve
  participant "SimilarArtistFinder" as finder
  participant "AvailabilityService" as avail
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database" as db
end box

actor -> page : Open /artists/ruth-adjei?date=2026-11-14
page -> client : get(slug)
client -> controller : GET /api/v1/artists/ruth-adjei?date=2026-11-14
controller -> resolve : handle(slug)
resolve -> db : artists.slug, then slug_histories.old_slug
db --> resolve : No row, or artist Suspended, Deleted or unpublished
resolve --> controller : Missing(context: primary style and base, or empty)
controller -> ex : throw ArtistNotFound
ex -> finder : forMissingArtist(context, Sat 14 Nov near Burlington within 120 km, 3)
finder -> db : Viewable artists with the same primary style
db --> finder : Candidates
finder -> avail : isFree(candidate, date) for each
avail --> finder : Free candidates
finder -> finder : Travel match and road distance from the church (L2-003),\nnearest first, take 3 (L2-021)
finder --> ex : Similar artists
ex --> client : 404 problem details, identical for every cause, no profile content (L2-021)
client --> page : ArtistNotFoundProblem
page -> page : Set SSR response status 404
page -> notfound : Render with up to 3 suggestions
notfound --> actor : "This artist isn't on Zamaro" with ticket cards carrying the date (L2-021)
@enduml
