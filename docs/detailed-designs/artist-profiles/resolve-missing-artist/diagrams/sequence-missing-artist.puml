@startuml
title UML sequence behaviour — Missing, suspended or deleted artist
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Booker or guest" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "ArtistPage" as page
  participant "ArtistProfileStore" as store
  participant "HttpArtistProfilesApi" as client
  participant "ArtistNotFoundPage" as notfound
end box
box "Backend — Zamaro API (Laravel HTTP layer)" #D1FADF
  participant "ArtistProfileController" as controller
  participant "ProblemDetailsRenderer" as renderer
end box
box "Backend — Zamaro Application and Domain" #ECFDF3
  participant "ResolveArtistSlug" as resolve
  participant "SimilarArtistFinder" as finder
  participant "AvailabilityService" as avail
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database" as db
end box

actor -> page : Open /artists/selah-brooks?date=2026-11-14
page -> store : load(slug, carried search: date, and kind, lat, lng, radius from the last lineup)
store -> client : get(slug, search)
client -> controller : GET /api/v1/artists/selah-brooks?date=2026-11-14[&kind&lat&lng&radius]
controller -> resolve : handle(slug)
resolve -> db : artists.slug, then slug_histories.slug with retired_at
db --> resolve : No row, or artist Suspended, Deleted, unpublished or without payout
resolve --> controller : throw ArtistNotFound(primary style, or none)
controller -> finder : forMissingArtist(style, carried search or Toronto · first bookable day · 120 km)
finder -> db : Viewable artists of that style in the bounding box
db --> finder : Candidates
finder -> avail : freeArtistIds(candidates, date, kind)
avail --> finder : Free candidates
finder -> finder : Travel rule and road distance (L2-003),\nnearest first, take 3 (L2-021)
finder --> controller : SimilarArtists(date, radiusKm, cards)
controller -> renderer : throw ArtistNotFound with similarArtists
renderer --> client : 404 artist-not-found problem, identical for every cause, no profile content (L2-021)
client --> store : ArtistNotFound (suggestions kept in the transfer state on the server)
store -> store : HttpStatus.set(404) during the server render
store --> page : status missing
page -> notfound : Render with the suggestions, the carried town and Discover's parameters
notfound --> actor : 404 "This artist isn't on Zamaro" with ticket cards carrying the date (L2-021)
@enduml
