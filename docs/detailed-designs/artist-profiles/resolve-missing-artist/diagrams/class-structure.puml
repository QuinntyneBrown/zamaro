@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Resolve a missing artist

package "Zamaro Web (Angular)" {
  class ArtistPage {
    -carriedSearch(date): CarriedSearch
    +carriedPlace: Signal<string | null>
  }
  class ArtistProfileStore {
    +status: Signal<'loading' | 'loaded' | 'missing' | 'error'>
    +similarArtists: Signal<SimilarArtists | null>
    +load(slug, search: CarriedSearch): void
    -move(slug): void
  }
  class HttpStatus <<root service>> {
    +set(status: number): void
  }
  class HttpArtistProfilesApi {
    +get(slug, search): Observable<ArtistProfile>
  }
  class "ArtistNotFound" as WebNotFound <<error>> {
    +similarArtists: SimilarArtists
  }
  class ArtistNotFoundPage {
    +similar: InputSignal<SimilarArtists>
    +place: InputSignal<string | null>
    +lineupParams: InputSignal<Params>
  }
  class NotFoundPage
  class ErrorPage <<zm-error-page>>
}

package "Zamaro API (Laravel)" {
  class ArtistProfileController {
    +show(request: ShowArtistProfileRequest, slug): JsonResponse
  }
  class ShowArtistProfileRequest {
    +carriedSearch(): SearchCriteria
  }
  class ResolveArtistSlug <<action>> {
    +handle(slug): Artist
  }
  class ArtistMoved <<exception, 301>> {
    +string currentSlug
  }
  class ArtistNotFound <<exception, 404>> {
    +?Style primaryStyle
    +?SimilarArtists similarArtists
    +withSimilarArtists(similar): ArtistNotFound
  }
  class SimilarArtistFinder {
    +forMissingArtist(style: ?Style, search: SearchCriteria, limit = 3): SimilarArtists
  }
  class SimilarArtists <<value object>> {
    +CarbonImmutable date
    +int radiusKm
    +LineupCard[] cards
  }
  class ProblemDetailsRenderer
  class SlugHistory <<Eloquent>> {
    +int artistId
    +string slug
    +?CarbonImmutable retiredAt
  }
  class Artist <<Eloquent>> {
    +string slug
    +ArtistStatus status
    +isVisible(): bool
    +primaryStyle(): ?Style
  }
}

ResolveArtistSlug ..> SlugHistory : reads retired slugs
ResolveArtistSlug ..> Artist : reads
ResolveArtistSlug ..> ArtistMoved : throws
ResolveArtistSlug ..> ArtistNotFound : throws
SlugHistory "*" --> "1" Artist
ArtistProfileController --> ResolveArtistSlug
ArtistProfileController --> SimilarArtistFinder
ArtistProfileController ..> ShowArtistProfileRequest
SimilarArtistFinder ..> SimilarArtists : returns
ProblemDetailsRenderer ..> ArtistMoved : 301 Location
ProblemDetailsRenderer ..> ArtistNotFound : artist-not-found problem
ArtistPage --> ArtistProfileStore
ArtistPage ..> ArtistNotFoundPage : renders when missing
ArtistProfileStore --> HttpArtistProfilesApi
ArtistProfileStore --> HttpStatus : 404 or 301
HttpArtistProfilesApi ..> WebNotFound : errors with
ArtistNotFoundPage --> ErrorPage
NotFoundPage --> ErrorPage
NotFoundPage --> HttpStatus : 404
@enduml
