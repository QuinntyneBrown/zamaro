@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Resolve a missing artist

Container_Boundary(web, "Zamaro Web") {
  Component(store, "ArtistProfileStore", "Page store", "Missing sets 404; a move sets 301 and navigates")
  Component(client, "HttpArtistProfilesApi", "Typed HTTP client", "Sends the carried search; follows 301; 404 becomes ArtistNotFound")
  Component(notfound, "ArtistNotFoundPage", "Angular component", "This artist isn't on Zamaro + suggestions")
  Component(generic, "NotFoundPage", "Angular page on **", "No show, served with 404")
}
Container_Boundary(api, "Zamaro API") {
  Component(ctrl, "ArtistProfileController", "Laravel controller", "show(slug) with the carried search")
  Component(resolve, "ResolveArtistSlug", "Action", "Viewable artist, or throws ArtistMoved / ArtistNotFound")
  Component(renderer, "ProblemDetailsRenderer", "Exception renderer", "301 Location, or the artist-not-found problem with similarArtists")
  Component(finder, "SimilarArtistFinder", "Domain service", "Same primary style, free on date, nearest first")
  Component(avail, "AvailabilityService", "Domain service", "freeArtistIds(artists, date, kind)")
  ComponentDb(db, "Zamaro database", "PostgreSQL 16", "artists, slug_histories")
}
Rel(store, client, "Loads profile with")
Rel(store, notfound, "Shown when missing")
Rel(client, ctrl, "GET /api/v1/artists/{slug}", "JSON/HTTPS")
Rel(ctrl, resolve, "Resolves slug with")
Rel(resolve, db, "Reads artists and slug_histories", "SQL")
Rel(ctrl, finder, "Fills suggestions with")
Rel(ctrl, renderer, "Throws to")
Rel(finder, avail, "Keeps artists free on the date")
Rel(finder, db, "Reads candidates by style", "SQL")
@enduml
