@startuml
title UML sequence behaviour — Prune entries older than 2 years
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Administrator" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "AdminAuditLogPage" as page
end box
box "Backend — Zamaro Worker (queue and scheduler)" #D1FADF
  participant "audit:prune" as cmd
  participant "PruneAuditEntries" as job
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database\n(retention role)" as db
end box

cmd -> job : Dispatch daily
job -> job : cutoff = now - 2 years (L2-069)
loop until no rows deleted
  job -> db : DELETE FROM audit_entries WHERE occurred_at < cutoff, one batch
  db --> job : Rows deleted
end
note over job, db : Re-running deletes nothing new; a missed day is caught up next run (L2-092)
actor -> page : Open /admin/audit
page --> actor : Oldest entry is no older than 2 years
@enduml
