@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Show reviews and rating

Person(guest, "Guest", "Anyone not signed in")
Person(booker, "Booker", "Signed-in church representative")
System(zamaro, "Zamaro", "Books Christian praise and worship artists around Toronto")
System_Ext(cdn, "CDN", "Serves web assets and artist images")

Rel(guest, zamaro, "Reads reviews and rating on artist profiles using", "HTTPS")
Rel(booker, zamaro, "Reads reviews and rating on artist profiles using", "HTTPS")
Rel(zamaro, cdn, "Serves profile assets through")
@enduml
