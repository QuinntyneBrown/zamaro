@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Pay out artists

package "Zamaro Web (Angular)" {
  class EarningsPage {
    +store: EarningsStore
    +payoutAccount: Signal<PayoutAccountStatusDto>
    +startOnboarding(): void
  }
  class EarningsStore {
    +lines: Signal<EarningsLineDto[]>
    +nextCursor: Signal<string | null>
    +loadMore(): void
  }
  class PayoutsApi {
    +onboardingLink(): Observable<{url: string}>
    +accountStatus(): Observable<PayoutAccountStatusDto>
    +earnings(cursor?: string): Observable<EarningsPageDto>
  }
}

package "Zamaro API and Worker (Laravel)" {
  class PayoutAccountController {
    +onboardingLink(request: Request): JsonResponse
    +show(request: Request): PayoutAccountResource
  }
  class EarningsController {
    +index(request: Request): EarningsLineResource[]
  }
  class StartPayoutOnboarding <<action>> {
    +handle(artist: Artist): string
  }
  class SyncConnectedAccount <<action>> {
    +handle(processorAccountId: string): Artist
  }
  class CreatePayout <<action>> {
    +handle(booking: Booking, collectedCents: int): Payout
  }
  class SendDuePayoutsCommand {
    +handle(): int
  }
  class SendPayout <<action>> {
    +handle(payout: Payout): Payout
  }
  class BusinessDayCalendar {
    +addBusinessDays(from: CarbonImmutable, days: int): CarbonImmutable
    +isBusinessDay(date: CarbonImmutable): bool
  }
  class Payout <<Eloquent>> {
    +int id
    +int bookingId
    +int artistId
    +int collectedCents
    +int feeCents
    +int amountCents
    +PayoutStatus status
    +CarbonImmutable dueBy
    +?string processorTransferId
    +?CarbonImmutable sentAt
    +?CarbonImmutable paidAt
  }
  class Artist <<Eloquent>> {
    +?string processorAccountId
    +bool payoutReady
    +?CarbonImmutable publishedAt
  }
  enum PayoutStatus {
    Scheduled
    Held
    Sent
    Paid
    Failed
  }
  interface PaymentGateway {
    +createConnectedAccount(artist: Artist): string
    +createOnboardingLink(accountId: string, returnUrl: string): string
    +retrieveConnectedAccount(accountId: string): ConnectedAccountStatus
    +createTransfer(accountId: string, amountCents: int, key: IdempotencyKey): ProcessorTransfer
  }
  class PriceBreakdown <<value object>> {
    +{static} platformFeeCents(collectedCents: int): int
  }
}

EarningsPage --> PayoutsApi
EarningsPage --> EarningsStore
EarningsStore --> PayoutsApi
PayoutsApi ..> PayoutAccountController
PayoutsApi ..> EarningsController
PayoutAccountController --> StartPayoutOnboarding
PayoutAccountController --> SyncConnectedAccount
StartPayoutOnboarding --> PaymentGateway
SyncConnectedAccount --> PaymentGateway
CreatePayout ..> PriceBreakdown : fee
CreatePayout ..> Payout : creates
SendDuePayoutsCommand --> BusinessDayCalendar
SendDuePayoutsCommand --> SendPayout
SendPayout --> PaymentGateway
Artist "1" --> "0..*" Payout
Payout --> PayoutStatus
@enduml
