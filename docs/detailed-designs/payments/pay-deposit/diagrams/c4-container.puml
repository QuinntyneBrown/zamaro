@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Pay the deposit

Person(booker, "Booker", "Signed-in church representative")
System_Ext(processor, "Payment processor", "Hosted card fields, 3-D Secure, saved cards")
System_Boundary(zamaro, "Zamaro") {
  Container(web, "Zamaro Web", "Angular with SSR", "PayDepositPage, payment summary and hosted card fields")
  Container(api, "Zamaro API", "PHP 8.3 / Laravel 11", "Deposit endpoints under /api/v1/bookings/{number}")
  Container(worker, "Zamaro Worker", "Laravel queue workers and scheduler", "Deposit expiry and notification jobs")
  ContainerDb(db, "Zamaro database", "PostgreSQL 16", "Bookings, payments, transitions; one Confirmed booking per artist and date")
  ContainerQueue(cache, "Cache and queue", "Redis", "Queued notification and receipt jobs")
}
Rel(booker, web, "Uses", "HTTPS")
Rel(web, processor, "Sends card number, expiry and CVC directly to", "Processor JS SDK")
Rel(web, api, "Requests summary, starts and confirms the deposit", "JSON/HTTPS")
Rel(api, processor, "Creates payment intent, retrieves payment, refunds", "HTTPS/JSON + idempotency key")
Rel(api, db, "Locks artist, writes Payment and Confirmed status", "Eloquent / SQL")
Rel(api, cache, "Dispatches BookingConfirmed listeners", "RESP")
Rel(worker, db, "Expires unpaid Accepted bookings", "SQL")
Rel(worker, cache, "Consumes jobs", "RESP")
@enduml
