@startuml
title UML sequence behaviour — Unpaid deposit expires
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Booker" as actor
box "Frontend — Zamaro Web (Angular)" #E0F2FE
  participant "BookingDetailPage" as page
end box
box "Backend — Zamaro Worker (queue and scheduler)" #D1FADF
  participant "Scheduler" as scheduler
  participant "ExpireUnpaidDepositsCommand" as command
end box
box "Backend — Zamaro Application and Domain" #ECFDF3
  participant "ExpireUnpaidDeposits" as action
  participant "BookingStateMachine" as sm
end box
box "Backend — Zamaro Infrastructure" #FFF4E5
  database "Zamaro database" as db
end box

scheduler -> command : bookings:expire-unpaid-deposits, every minute
command -> action : handle(now)
action -> db : Accepted bookings with depositDueBy <= now and no Succeeded deposit
note right of db : depositDueBy = min(accepted + 48 h, event start - 12 h)\nin America/Toronto wall-clock time (L2-037, L2-110)
db --> action : Due bookings
loop each due booking
  action -> sm : transition(Accepted -> Expired) only if still Accepted (L2-092)
  sm -> db : Conditional update, insert BookingTransition
  action -> action : Dispatch RequestExpired to booker and artist (L2-037, L2-063)
end
action --> command : Count expired
actor -> page : Open /bookings/{number}
page --> actor : Status Expired; Pay deposit no longer offered
@enduml
