{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "zamaro": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/zamaro",
      "sourceRoot": "projects/zamaro/src",
      "prefix": "zm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/zamaro/src/main.ts",
            "tsConfig": "projects/zamaro/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/zamaro/public"
              }
            ],
            "styles": [
              "projects/components/src/styles/tokens.css",
              "projects/components/src/styles/index.scss",
              "@angular/cdk/overlay-prebuilt.css",
              "projects/zamaro/src/styles.scss"
            ],
            "server": "projects/zamaro/src/main.server.ts",
            "outputMode": "server",
            "allowedCommonJsDependencies": ["@messageformat/core"],
            "security": {
              "allowedHosts": ["localhost"]
            },
            "ssr": {
              "entry": "projects/zamaro/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "zamaro:build:production"
            },
            "development": {
              "buildTarget": "zamaro:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/zamaro/src/**/*.ts", "projects/zamaro/src/**/*.html"]
          }
        }
      }
    },
    "admin": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/admin",
      "sourceRoot": "projects/admin/src",
      "prefix": "zm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
