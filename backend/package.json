{
  "name": "zamaro-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 8000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 8000 --hostname 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/db-migrate.ts",
    "db:seed": "tsx src/cli/db-seed.ts",
    "db:reset": "tsx src/cli/db-reset.ts",
    "cast:booker": "tsx src/cli/cast-booker.ts",
    "worker": "tsx src/worker.ts",
    "openapi:export": "tsx src/cli/openapi-export.ts",
    "openapi:check": "tsx src/cli/openapi-export.ts --check"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "next": "^16.4.2",
    "otplib": "^12.0.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
